# Local configuration (may contain secrets)
.env
.env.*
.env-lock/
!.env.example

# Runtime state owned by the gateway (never commit)
state/

# TLS material
# Generated by `portta tls init`, alongside the certificate it points at.
config/traefik/dynamic/local-tls.yaml

# Generated by the panel and by `portta protect`: they carry a password hash,
# and their contents are derived from .env and the protection store.
config/traefik/dynamic/portta-shares.yaml
config/traefik/dynamic/portta-aliases.yaml
config/traefik/dynamic/portta-auth.yaml
config/tls/*
!config/tls/.gitkeep

# Secrets
*.pem
*.key
*.crt
acme.json
tailscaled.state
*.authkey

# OS / editors
.DS_Store
._*
.idea/
.vscode/

# Agent tooling state
.claude/
*.swp

# Workspace install and build artifacts (the image builds them; they are never committed)
node_modules/
apps/web/node_modules/
apps/*/dist/
apps/web/test-results/
apps/web/playwright-report/
apps/web/.next/
apps/web/next-env.d.ts
apps/web/tsconfig.tsbuildinfo
packages/*/node_modules/
packages/*/dist/
# Generated by npm run build --workspace=@codions/portta from the files at
# the repository root: npm only publishes the README and the licence that
# sit at the root of the package.
packages/cli/README.md
packages/cli/LICENSE

# Test artifacts
/test-results/

/docs/.generated/

# Repository-only notes, never published or committed
docs/research/
.prompts/
