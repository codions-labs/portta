{
  "name": "portta-auth",
  "version": "0.1.0",
  "private": true,
  "description": "ForwardAuth and browser session boundary for Portta",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run build:ui && concurrently --kill-others-on-fail --names server,ui \"npm:dev:server\" \"npm:dev:ui\"",
    "dev:server": "node --conditions=development --watch src/index.ts",
    "dev:ui": "vite build --watch",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "vitest run",
    "build:ui": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.16",
    "portta-core": "0.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "9.2.5",
    "i18next": "^26.5.12",
    "lucide-react": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
