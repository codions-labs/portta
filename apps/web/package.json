{
  "name": "portta-web",
  "version": "0.1.0",
  "private": true,
  "description": "Administration panel for Portta",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development NODE_OPTIONS=--conditions=development tsx watch --clear-screen=false server/main.ts",
    "build": "next build --webpack && node --import tsx esbuild.server.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "node e2e/screenshots.mjs",
    "viewports": "npm run build && node e2e/viewports.mjs",
    "prebuild": "node --import tsx ../../tooling/docs.mjs --bundle"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.15",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@tanstack/react-query": "5.105.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-auth": "1.7.15",
    "diff2html": "^3.4.56",
    "hono": "4.13.16",
    "i18next": "^26.5.12",
    "lucide-react": "1.65.0",
    "next": "16.4.4",
    "portta-auth-core": "0.1.0",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "portta-db": "0.1.0",
    "portta-server": "0.1.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "markdown-it": "^15.0.3",
    "mermaid": "11.17.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
