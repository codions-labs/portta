// Managed by Portta: `portta agents install` writes this file and `portta agents uninstall` removes it. Do not edit.
// Adds the host context to the first turn of each session.
import type { ExtensionAPI } from '@earendil-works/pi-coding-agent'

const HOOK = __PORTTA_HOOK_PATH__

export default function (pi: ExtensionAPI) {
  let injected = false
  pi.on('session_start', () => {
    injected = false
  })
  pi.on('before_agent_start', async (event, ctx) => {
    if (injected || event.messageType === 'custom') return
    injected = true
    try {
      const result = await pi.exec('bash', [HOOK], { timeout: 8000, cwd: ctx.cwd })
      const content = result.stdout.trim()
      if (result.code !== 0 || !content) return
      return { message: { customType: 'portta-context', content, display: false } }
    } catch {
      // The context is a courtesy: a failing hook never blocks the session.
    }
  })
}
