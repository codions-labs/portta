{
  "name": "@codions/portta",
  "version": "0.0.0-local",
  "description": "Machine-first CLI for a shared Docker development gateway",
  "keywords": [
    "docker",
    "docker-compose",
    "traefik",
    "development",
    "gateway",
    "devcontainer",
    "reverse-proxy"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "portta": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codions-labs/portta.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/codions-labs/portta#readme",
  "bugs": "https://github.com/codions-labs/portta/issues",
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "commander": "14.0.2",
    "execa": "9.6.1",
    "systeminformation": "^5.33.8",
    "yaml": "^2.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "tsx": "4.23.15"
  }
}
