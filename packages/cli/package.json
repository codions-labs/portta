{
  "name": "@codions/portta",
  "version": "0.0.0-local",
  "description": "Machine-first CLI for a shared Docker development gateway",
  "keywords": [
    "docker",
    "docker-compose",
    "traefik",
    "development",
    "gateway",
    "devcontainer",
    "reverse-proxy",
    "mcp"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "portta": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codions-labs/portta.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/codions-labs/portta#readme",
  "bugs": "https://github.com/codions-labs/portta/issues",
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.76.0",
    "@agentclientprotocol/codex-acp": "^1.11.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.163",
    "@clack/prompts": "^1.1.0",
    "@devcontainers/cli": "0.89.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.11.1",
    "commander": "14.0.2",
    "execa": "9.6.1",
    "pi-acp": "^0.0.33",
    "systeminformation": "^5.33.8",
    "ws": "8.19.0",
    "yaml": "^2.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "portta-host": "0.1.0",
    "portta-mcp": "0.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "tsx": "4.23.13"
  }
}
