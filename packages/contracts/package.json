{
  "name": "portta-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "The panel's API contract: schemas, types and the generated OpenAPI document",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json",
    "./taskflow": {
      "types": "./src/taskflow/index.ts",
      "development": "./src/taskflow/index.ts",
      "import": "./dist/taskflow/index.js"
    },
    "./taskflow.openapi.json": "./taskflow.openapi.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "taskflow.openapi.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "node --conditions=development scripts/generate-openapi.ts",
    "openapi:check": "node --conditions=development scripts/generate-openapi.ts --check",
    "openapi:taskflow": "node --conditions=development scripts/generate-taskflow-openapi.ts",
    "openapi:taskflow:check": "node --conditions=development scripts/generate-taskflow-openapi.ts --check"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "portta-core": "0.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "portta-host": "0.1.0",
    "portta-server": "0.1.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
