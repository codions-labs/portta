{
  "name": "portta-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared domain logic for Portta panel and CLI",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./zod": {
      "types": "./src/zod.ts",
      "development": "./src/zod.ts",
      "import": "./dist/zod.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "development": "./src/browser.ts",
      "import": "./dist/browser.js"
    },
    "./documentation-compile": {
      "types": "./src/documentation-compile.ts",
      "development": "./src/documentation-compile.ts",
      "import": "./dist/documentation-compile.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@types/markdown-it": "^14.2.0"
  },
  "dependencies": {
    "zod": "4.6.7",
    "markdown-it": "^15.0.3"
  }
}
