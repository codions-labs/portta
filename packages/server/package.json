{
  "name": "portta-server",
  "version": "0.1.0",
  "private": true,
  "description": "The panel's services, HTTP API and background work",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hono/standard-validator": "0.4.1",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.11",
    "@types/json-schema": "7.0.15",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "hono-openapi": "1.5.0",
    "openapi-types": "12.1.3",
    "portta-auth-core": "0.1.0",
    "portta-contracts": "0.1.0",
    "portta-core": "0.1.0",
    "portta-db": "0.1.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
